{
  "name": "english-forge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:types": "supabase gen types typescript --project-id nqjbtiuygrxyvlmfrklt --schema public > src/lib/supabase/database.types.ts",
    "db:push": "supabase db push",
    "enrich": "tsx --conditions=react-server scripts/enrich-words.ts",
    "seed": "tsx --conditions=react-server scripts/seed-words.ts",
    "models": "tsx scripts/list-models.ts",
    "words:report": "tsx scripts/report-words.ts",
    "test-user": "tsx scripts/create-test-user.ts",
    "dev:lan": "next dev -H 0.0.0.0"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.125",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "ai": "^7.0.181",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "ts-fsrs": "^6.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "supabase": "^3.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
