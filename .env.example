# EnglishForge ortam değişkenleri (docs/SPEC.md bölüm 14)
# Bu dosyayı .env.local olarak kopyala ve değerleri doldur. Gerçek değerleri asla buraya yazma.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODELS=
AI_DAILY_LIMIT=
ALLOWED_EMAILS=
CRON_SECRET=
APP_TIMEZONE=
DAY_START_HOUR=

# İsteğe bağlı
